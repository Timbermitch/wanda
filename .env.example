# --- Microsoft Fabric (Service Principal) ------------------------------------
FABRIC_TENANT_ID=your-tenant-guid-here
FABRIC_CLIENT_ID=your-service-principal-client-id-here
FABRIC_CLIENT_SECRET=your-service-principal-secret-here
FABRIC_WORKSPACE_ID=your-fabric-workspace-guid-here

# --- LLM provider -------------------------------------------------------------
# Which model backend Wanda uses: anthropic (default) | azure-openai | azure-anthropic
WANDA_PROVIDER=anthropic

# For the default "anthropic" provider (console.anthropic.com -> API Keys):
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Optional model override (default: claude-sonnet-4-6):
# WANDA_MODEL=claude-sonnet-4-6
# Optional API base-URL override (proxies / gateways):
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# For the "azure-openai" provider (Azure AI Foundry project -> endpoint/key):
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-azure-openai-key-here
# AZURE_OPENAI_DEPLOYMENT=gpt-5

# For the experimental "azure-anthropic" provider (Claude on Azure AI Foundry):
# AZURE_ANTHROPIC_ENDPOINT=https://your-resource.services.ai.azure.com
# AZURE_ANTHROPIC_API_KEY=your-azure-anthropic-key-here
# AZURE_ANTHROPIC_DEPLOYMENT=claude-sonnet-4-6

# --- Logging ------------------------------------------------------------------
# WANDA_LOG_LEVEL=INFO
